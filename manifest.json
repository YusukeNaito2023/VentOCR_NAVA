  "breath_summary": ["VTe", "Real_VTe", "EdiPeak", "Cdyn", "IE_Ratio"],

  "accuracy": {
    "VTe":        { "method": null, "threshold": null, "unit": "mL" },
    "VTi":        { "method": null, "threshold": null, "unit": "mL" },
    "Cdyn":       { "method": null, "threshold": null, "unit": "mL/cmH2O" },
    "BreathMark": { "method": null, "threshold": null }
  }
}
