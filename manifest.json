{
  "engine_key": "nava_ventocr_v1_1",
  "display_name": "NAVA v1.1",
  "developer": "VentOCR Developer Team",
  "version": "1.1.0",
  "ventocr_min": "0.5.5",
  "description": "Servo-U ventilator Edi waveform OCR engine (resolution-independent; frames normalized to 1280x720)",

